# Chedam hub HTTPS front (generated by setup-hub.sh; __HUB_IP__ is replaced with the hub's LAN IP).
# Caddy's internal CA is created on this hub, so every store has its own CA (never shared between stores).
# Phones that cannot resolve .local names (e.g. Android 9) use the IP address instead.
{
	skip_install_trust
	pki {
		ca local {
			name "Chedam Store CA"
		}
	}
}

chedam.local, __HUB_IP__ {
	tls internal
	encode gzip
	reverse_proxy 127.0.0.1:8090
}

# Plain HTTP: only the root certificate download for device pairing (FR-1.07); everything else goes to HTTPS.
http://chedam.local, http://__HUB_IP__ {
	handle /ca.crt {
		root * /var/lib/caddy/.local/share/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}
