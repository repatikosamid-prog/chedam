# Chedam hub HTTPS front (generated by setup-hub.sh; __HUB_IP__ is replaced with the hub's LAN IP).
# Caddy's internal CA is created on this hub, so every store has its own CA (never shared between stores).
# Phones that cannot resolve .local names (e.g. Android 9) use the IP address instead.
{
	skip_install_trust
	pki {
		ca local {
			name "Chedam Store CA"
		}
	}
}

chedam.local, __HUB_IP__ {
	tls internal
	encode gzip
	# The hub's LAN address, so pairing QR codes carry the IP (Android 9 cannot resolve .local names)
	handle /hub.json {
		header Content-Type application/json
		respond `{"ip":"__HUB_IP__","name":"chedam.local"}`
	}
	handle {
		reverse_proxy 127.0.0.1:8090
	}
}

# Plain HTTP: only what a new device needs before it trusts the store CA (FR-1.07): the certificate
# download and the install guide (with its styles). Everything else goes to HTTPS.
http://chedam.local, http://__HUB_IP__ {
	handle /device-setup.html {
		reverse_proxy 127.0.0.1:8090
	}
	handle /assets/chedam.css {
		reverse_proxy 127.0.0.1:8090
	}
	handle /ca.crt {
		root * /var/lib/caddy/.local/share/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}
