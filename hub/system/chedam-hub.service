[Unit]
Description=Chedam hub (PocketBase)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=chedam-hub
Group=chedam-hub
WorkingDirectory=/opt/chedam
ExecStart=/opt/chedam/bin/pocketbase serve \
  --http=127.0.0.1:8090 \
  --dir=/opt/chedam/pb_data \
  --hooksDir=/opt/chedam/pb_hooks \
  --migrationsDir=/opt/chedam/pb_migrations \
  --publicDir=/opt/chedam/pb_public
Restart=always
RestartSec=2

# NFR-08: hub app < 150 MB on the Pi Zero 2 W. GOMEMLIMIT makes Go collect early;
# MemoryMax is a hard stop well above the target so a leak restarts instead of freezing the Pi.
Environment=GOMEMLIMIT=100MiB
MemoryHigh=150M
MemoryMax=220M

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/chedam/pb_data
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
